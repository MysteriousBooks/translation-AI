.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}
.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 32rpx;
}
.empty-button {
  background-color: #4A90D9;
  color: #FFFFFF;
  border-radius: 12rpx;
  padding: 16rpx 64rpx;
  font-size: 28rpx;
}
.empty-button:active {
  opacity: 0.8;
}
