.order-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.order-no {
  font-size: 24rpx;
  color: #999999;
}
.order-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
.status-0 {
  color: #FAAD14;
  background-color: #FFF8E6;
}
.status-1 {
  color: #52C41A;
  background-color: #F6FFED;
}
.status-2 {
  color: #999999;
  background-color: #F5F5F5;
}
.status-3 {
  color: #F5222D;
  background-color: #FFF1F0;
}
.order-body {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.order-amount {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}
.order-time {
  font-size: 22rpx;
  color: #999999;
}
