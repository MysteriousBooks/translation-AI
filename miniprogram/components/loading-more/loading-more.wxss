.loading-more {
  padding: 24rpx 0;
  text-align: center;
}
.loading-content {
  display: flex;
  align-items: center;
  justify-content: center;
}
.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #4A90D9;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 12rpx;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: 24rpx;
  color: #999999;
}
.finished-text {
  font-size: 24rpx;
  color: #cccccc;
}
