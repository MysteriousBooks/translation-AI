<view class="container">
  <!-- 用户信息卡片 -->
  <view class="user-card card">
    <view class="user-info" bindtap="onEditProfile">
      <image class="avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
      <view class="user-detail">
        <text class="nickname">{{userInfo.nickname || '未设置昵称'}}</text>
        <text class="balance-text">余额: ¥{{balance}}</text>
      </view>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="menu-card card">
    <view class="menu-item" bindtap="onEditProfile">
      <text class="menu-icon">👤</text>
      <text class="menu-text">编辑资料</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onChangePassword">
      <text class="menu-icon">🔒</text>
      <text class="menu-text">修改密码</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onWallet">
      <text class="menu-icon">💰</text>
      <text class="menu-text">我的钱包</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-card card">
    <view class="menu-item" bindtap="onNoticeList">
      <text class="menu-icon">📢</text>
      <text class="menu-text">公告通知</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onFeedback">
      <text class="menu-icon">✉️</text>
      <text class="menu-text">意见反馈</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>
