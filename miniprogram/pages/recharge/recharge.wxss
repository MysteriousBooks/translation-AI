.balance-card {
  text-align: center;
  margin-bottom: 32rpx;
}
.balance-label {
  font-size: 28rpx;
  color: #999999;
  display: block;
  margin-bottom: 8rpx;
}
.balance-amount {
  font-size: 56rpx;
  font-weight: 700;
  color: #333333;
  display: block;
}
.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 24rpx;
}
.amount-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 32rpx;
}
.amount-item {
  width: calc(33.33% - 14rpx);
  text-align: center;
  padding: 32rpx 0;
  background-color: #FFFFFF;
  border: 2rpx solid #E0E0E0;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.amount-item.active {
  border-color: #4A90D9;
  color: #4A90D9;
  background-color: #EBF2FA;
}
.custom-amount {
  margin-bottom: 32rpx;
}
.custom-label {
  font-size: 28rpx;
  color: #666666;
  display: block;
  margin-bottom: 16rpx;
}
.custom-input-wrap {
  display: flex;
  align-items: center;
  border: 2rpx solid #E0E0E0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 80rpx;
}
.custom-unit {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-right: 8rpx;
}
.custom-input {
  flex: 1;
  font-size: 30rpx;
  height: 80rpx;
}
.submit-btn {
  text-align: center;
  margin-top: 16rpx;
}
.disabled {
  opacity: 0.6;
}
