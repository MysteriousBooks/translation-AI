.container {
  padding: 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
.lang-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}
.lang-item {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  padding: 12rpx 24rpx;
  background-color: #F5F5F5;
  border-radius: 12rpx;
}
.lang-arrow {
  font-size: 20rpx;
  color: #999999;
  margin-left: 8rpx;
}
.lang-swap {
  padding: 12rpx;
}
.swap-icon {
  font-size: 40rpx;
  color: #4A90D9;
}
.input-card {
  min-height: 300rpx;
}
.translate-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #333333;
}
.input-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}
.char-count {
  font-size: 24rpx;
  color: #999999;
}
.clear-btn {
  font-size: 24rpx;
  color: #4A90D9;
  padding: 8rpx 16rpx;
}
.translate-btn {
  margin: 24rpx 0;
  text-align: center;
}
.result-card {
  margin-top: 24rpx;
}
.result-header {
  margin-bottom: 16rpx;
}
.result-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}
.result-content {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.8;
  padding: 24rpx;
  background-color: #F8F9FA;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}
.result-actions {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
}
.result-btn {
  padding: 12rpx 32rpx;
  border: 2rpx solid #4A90D9;
  border-radius: 8rpx;
  color: #4A90D9;
  font-size: 26rpx;
}
.result-btn:active {
  opacity: 0.7;
}
