.info-card {
  margin-bottom: 24rpx;
}
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}
.info-row:last-child {
  border-bottom: none;
}
.info-label {
  font-size: 28rpx;
  color: #999999;
}
.info-value {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}
.status-0 { color: #FAAD14; }
.status-1 { color: #52C41A; }
.status-2 { color: #F5222D; }
.text-card {
  margin-bottom: 24rpx;
}
.text-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.text-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
}
.copy-btn {
  font-size: 24rpx;
  color: #4A90D9;
  padding: 4rpx 16rpx;
}
.text-content {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.8;
}
.error-card {
  background-color: #FFF1F0;
}
.error-text {
  font-size: 26rpx;
  color: #F5222D;
}
