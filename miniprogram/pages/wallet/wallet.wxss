.balance-card {
  text-align: center;
  margin-bottom: 32rpx;
}
.balance-label {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 16rpx;
}
.balance-amount {
  font-size: 64rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 16rpx;
}
.balance-info {
  margin-bottom: 32rpx;
}
.balance-consume {
  font-size: 24rpx;
  color: #999999;
}
.recharge-btn {
  width: 100%;
}
.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 24rpx;
}
.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.record-left {
  display: flex;
  flex-direction: column;
  flex: 1;
}
.record-type {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 4rpx;
}
.record-desc {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.record-time {
  font-size: 22rpx;
  color: #CCCCCC;
}
.record-right {
  font-size: 32rpx;
  font-weight: 600;
}
.income {
  color: #52C41A;
}
.expense {
  color: #F5222D;
}
