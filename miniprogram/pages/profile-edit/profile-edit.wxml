<view class="container">
  <!-- 头像 -->
  <view class="avatar-section" bindtap="onChooseAvatar">
    <image class="avatar" src="{{avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
    <text class="avatar-tip">点击更换头像</text>
  </view>

  <!-- 昵称 -->
  <view class="form-item card">
    <text class="form-label">昵称</text>
    <input
      class="form-input"
      placeholder="请输入昵称"
      value="{{nickname}}"
      bindinput="onNicknameInput"
      maxlength="64"
    />
  </view>

  <!-- 保存按钮 -->
  <view class="btn-primary save-btn" bindtap="onSave">保存</view>
</view>
