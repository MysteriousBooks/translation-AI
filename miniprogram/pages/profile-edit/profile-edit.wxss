.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 48rpx 0;
}
.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #F0F0F0;
  margin-bottom: 16rpx;
}
.avatar-tip {
  font-size: 24rpx;
  color: #4A90D9;
}
.form-item {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.form-label {
  width: 120rpx;
  font-size: 28rpx;
  color: #333333;
  flex-shrink: 0;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}
.save-btn {
  margin-top: 48rpx;
  text-align: center;
}
